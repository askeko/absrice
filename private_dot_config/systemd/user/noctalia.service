[Unit]
Description=Noctalia desktop shell (bar, notifications, lock screen, wallpaper)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
# Noctalia finds the logind session through XDG_SESSION_ID, which the user
# manager does not have. Without it, logind lock requests (YubiKey pull) are ignored.
ExecStart=/bin/sh -c 'XDG_SESSION_ID=$$(loginctl show-user "$$(id -un)" -p Display --value) exec /usr/bin/noctalia'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
