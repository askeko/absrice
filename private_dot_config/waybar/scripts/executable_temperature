#!/bin/sh
# CPU temperature for waybar: the first temp1_input lm_sensors reports.

temp=$(sensors -j 2>/dev/null | jq -r '
    [.. | objects | to_entries[] | select(.key == "temp1_input")] | first | .value // empty | round
')

if [ -z "$temp" ]; then
    echo '{"text":"󱃃 ?°","class":""}'
    exit 0
fi

if [ "$temp" -ge 80 ]; then
    icon="󰸁" class="critical"
elif [ "$temp" -ge 60 ]; then
    icon="󱩿" class=""
else
    icon="󱃃" class=""
fi
printf '{"text":"%s %s°","class":"%s"}\n' "$icon" "$temp" "$class"
