# Environment shared by the desktop session (sourced from ~/.config/uwsm/env)
# and login shells (sourced from ~/.config/shell/profile). POSIX sh, and safe
# to source more than once.

# XDG base directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Own scripts and user-installed binaries (Claude and Codex) come first.
case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Default programs
export EDITOR="nvim"
export VISUAL="nvim"
export TERMINAL="kitty"
export BROWSER="firefox"

# Keep ~ tidy
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export LESSHISTFILE="-"
export NODE_REPL_HISTORY="$XDG_STATE_HOME/node_repl_history"
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"
export PYTHON_HISTORY="$XDG_STATE_HOME/python_history"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"

# Theme
export BAT_THEME="tokyonight_night"
export FZF_DEFAULT_OPTS=""
[ -f "$XDG_CONFIG_HOME/fzf/theme.sh" ] && . "$XDG_CONFIG_HOME/fzf/theme.sh"
