# Colours (and the urgency sections that use them) come from the theme file.
include=~/.config/mako/theme

anchor=top-right
default-timeout=3000
ignore-timeout=1

# wallpaper-picker's "Wallpaper changed" shows a big preview, briefly.
[app-name=Wallpaper]
default-timeout=2000
max-icon-size=128

# Manual privacy and automatic screenshare suppression are independent.
[mode=privacy]
invisible=1

[mode=screenshare]
invisible=1
